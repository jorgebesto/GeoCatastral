{
  "name": "GeoCatastral — Registro Catastral y Estudio de Mercado",
  "short_name": "GeoCatastral",
  "description": "Registro fotográfico georreferenciado por manzanas y estudio de mercado inmobiliario en campo.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#111318",
  "theme_color": "#191d26",
  "lang": "es-CO",
  "dir": "ltr",
  "categories": ["productivity", "business", "utilities", "navigation"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 480 },
  "icons": [
    { "src": "icons/favicon-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Registro Catastral",
      "short_name": "Catastral",
      "description": "Cargar un Shapefile o GeoPackage y registrar fotos por manzana",
      "url": "./?modo=catastral&source=shortcut",
      "icons": [{ "src": "icons/shortcut-catastral-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Estudio de Mercado",
      "short_name": "Mercado",
      "description": "Abrir el mapa para registrar ofertas, precios y contactos",
      "url": "./?modo=mercado&source=shortcut",
      "icons": [{ "src": "icons/shortcut-mercado-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/movil-seleccion.png",
      "sizes": "1082x2402",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Selección de herramienta: Registro Catastral o Estudio de Mercado"
    },
    {
      "src": "screenshots/escritorio-seleccion.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GeoCatastral en escritorio"
    }
  ]
}
